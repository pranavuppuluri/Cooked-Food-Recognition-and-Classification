# Windows download provenance streams. These were committed by accident once and
# made the repository impossible to check out on Windows at all, because ':' is
# not a legal filename character there.
*:Zone.Identifier

# Model weights and checkpoints - too large for git.
*.pth
*.pt
*.ckpt
*.onnx

# Training runs: weights and per-run logs. Summaries worth keeping go in results/.
runs/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Notebook exports
*.pdf
